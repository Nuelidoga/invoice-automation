{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "la-invoice-automation"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique, 3-24 lowercase letters/digits"
      }
    },
    "docIntelligenceName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique; also used as custom subdomain"
      }
    },
    "approverEmail": {
      "type": "string",
      "metadata": {
        "description": "Who approves large invoices"
      }
    },
    "approvalThreshold": {
      "type": "int",
      "defaultValue": 1000
    },
    "financeEmail": {
      "type": "string",
      "metadata": {
        "description": "Finance team mailbox/distribution list for notifications"
      }
    },
    "sqlServerName": {
      "type": "string",
      "metadata": {
        "description": "Globally unique SQL server name"
      }
    },
    "sqlDatabaseName": {
      "type": "string",
      "defaultValue": "InvoiceDb"
    },
    "sqlAdminLogin": {
      "type": "string"
    },
    "sqlAdminPassword": {
      "type": "securestring"
    },
    "deployOutlookConnection": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Set false when redeploying so the authorized Outlook.com connection is not reset"
      }
    }
  },
  "variables": {
    "storageId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
    "diId": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('docIntelligenceName'))]",
    "sqlServerId": "[resourceId('Microsoft.Sql/servers', parameters('sqlServerName'))]",
    "sqlFqdn": "[concat(parameters('sqlServerName'), environment().suffixes.sqlServerHostname)]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(parameters('storageAccountName'), '/default/invoices')]",
      "dependsOn": [
        "[variables('storageId')]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('docIntelligenceName')]",
      "location": "[parameters('location')]",
      "kind": "FormRecognizer",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[parameters('docIntelligenceName')]",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "outlook",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Invoice mailbox (Outlook.com)",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'outlook')]"
        }
      },
      "condition": "[parameters('deployOutlookConnection')]"
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "azureblob",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('storageId')]"
      ],
      "properties": {
        "displayName": "Invoice archive (Blob)",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azureblob')]"
        },
        "parameterValues": {
          "accountName": "[parameters('storageAccountName')]",
          "accessKey": "[listKeys(variables('storageId'), '2023-01-01').keys[0].value]"
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2021-11-01",
      "name": "[parameters('sqlServerName')]",
      "location": "[parameters('location')]",
      "properties": {
        "administratorLogin": "[parameters('sqlAdminLogin')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "version": "12.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2021-11-01",
      "name": "[concat(parameters('sqlServerName'),'/AllowAzureServices')]",
      "dependsOn": [
        "[variables('sqlServerId')]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2021-11-01",
      "name": "[concat(parameters('sqlServerName'),'/',parameters('sqlDatabaseName'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('sqlServerId')]"
      ],
      "sku": {
        "name": "Basic",
        "tier": "Basic"
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "sql",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', parameters('sqlServerName'), parameters('sqlDatabaseName'))]"
      ],
      "properties": {
        "displayName": "Invoice ledger (Azure SQL)",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sql')]"
        },
        "parameterValues": {
          "server": "[variables('sqlFqdn')]",
          "database": "[parameters('sqlDatabaseName')]",
          "authType": "basic",
          "username": "[parameters('sqlAdminLogin')]",
          "password": "[parameters('sqlAdminPassword')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', 'outlook')]",
        "[resourceId('Microsoft.Web/connections', 'azureblob')]",
        "[resourceId('Microsoft.Web/connections', 'sql')]",
        "[variables('diId')]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "approvalThreshold": {
              "type": "Int",
              "defaultValue": 1000
            },
            "approverEmail": {
              "type": "String",
              "defaultValue": ""
            },
            "diEndpoint": {
              "type": "String",
              "defaultValue": ""
            },
            "diKey": {
              "type": "SecureString",
              "defaultValue": ""
            },
            "financeEmail": {
              "type": "String",
              "defaultValue": ""
            },
            "sqlServer": {
              "type": "String",
              "defaultValue": ""
            },
            "sqlDatabase": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "When_a_new_invoice_email_arrives": {
              "type": "ApiConnection",
              "recurrence": {
                "frequency": "Minute",
                "interval": 1
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['outlook']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/Mail/OnNewEmail",
                "queries": {
                  "folderPath": "Inbox",
                  "fetchOnlyWithAttachment": true,
                  "includeAttachments": true,
                  "importance": "Any",
                  "subjectFilter": "Invoice"
                }
              },
              "splitOn": "@triggerBody()?['value']"
            }
          },
          "actions": {
            "Init_status": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "status",
                    "type": "string",
                    "value": "notStarted"
                  }
                ]
              }
            },
            "Init_result": {
              "type": "InitializeVariable",
              "runAfter": {
                "Init_status": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "result",
                    "type": "object",
                    "value": {}
                  }
                ]
              }
            },
            "Init_decision": {
              "type": "InitializeVariable",
              "runAfter": {
                "Init_result": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "variables": [
                  {
                    "name": "decision",
                    "type": "string",
                    "value": "Pending"
                  }
                ]
              }
            },
            "For_each_attachment": {
              "type": "Foreach",
              "foreach": "@coalesce(triggerBody()?['attachments'], triggerBody()?['Attachments'], json('[]'))",
              "runAfter": {
                "Init_decision": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "actions": {
                "Only_process_PDFs": {
                  "type": "If",
                  "runAfter": {},
                  "expression": {
                    "and": [
                      {
                        "endsWith": [
                          "@toLower(coalesce(items('For_each_attachment')?['name'], items('For_each_attachment')?['Name']))",
                          ".pdf"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Archive_invoice_to_Blob": {
                      "type": "ApiConnection",
                      "runAfter": {},
                      "inputs": {
                        "host": {
                          "connection": {
                            "name": "@parameters('$connections')['azureblob']['connectionId']"
                          }
                        },
                        "method": "post",
                        "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files",
                        "queries": {
                          "folderPath": "/invoices",
                          "name": "@{formatDateTime(utcNow(),'yyyyMMddHHmmss')}_@{coalesce(items('For_each_attachment')?['name'], items('For_each_attachment')?['Name'])}",
                          "queryParametersSingleEncoded": true
                        },
                        "body": "@base64ToBinary(coalesce(items('For_each_attachment')?['contentBytes'], items('For_each_attachment')?['ContentBytes']))"
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Reset_status": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Archive_invoice_to_Blob": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "status",
                        "value": "running"
                      }
                    },
                    "Submit_to_Document_Intelligence": {
                      "type": "Http",
                      "runAfter": {
                        "Reset_status": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "method": "POST",
                        "uri": "@{parameters('diEndpoint')}documentintelligence/documentModels/prebuilt-invoice:analyze?api-version=2024-11-30",
                        "headers": {
                          "Ocp-Apim-Subscription-Key": "@parameters('diKey')",
                          "Content-Type": "application/json"
                        },
                        "body": {
                          "base64Source": "@coalesce(items('For_each_attachment')?['contentBytes'], items('For_each_attachment')?['ContentBytes'])"
                        }
                      }
                    },
                    "Until_analysis_complete": {
                      "type": "Until",
                      "runAfter": {
                        "Submit_to_Document_Intelligence": [
                          "Succeeded"
                        ]
                      },
                      "expression": "@or(equals(variables('status'),'succeeded'),equals(variables('status'),'failed'))",
                      "limit": {
                        "count": 20,
                        "timeout": "PT5M"
                      },
                      "actions": {
                        "Wait_5_seconds": {
                          "type": "Wait",
                          "runAfter": {},
                          "inputs": {
                            "interval": {
                              "count": 5,
                              "unit": "Second"
                            }
                          }
                        },
                        "Poll_result": {
                          "type": "Http",
                          "runAfter": {
                            "Wait_5_seconds": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "method": "GET",
                            "uri": "@{outputs('Submit_to_Document_Intelligence')['headers']['Operation-Location']}",
                            "headers": {
                              "Ocp-Apim-Subscription-Key": "@parameters('diKey')"
                            }
                          }
                        },
                        "Set_status": {
                          "type": "SetVariable",
                          "runAfter": {
                            "Poll_result": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "name": "status",
                            "value": "@{body('Poll_result')?['status']}"
                          }
                        },
                        "Set_result": {
                          "type": "SetVariable",
                          "runAfter": {
                            "Set_status": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "name": "result",
                            "value": "@body('Poll_result')"
                          }
                        }
                      }
                    },
                    "Extract_fields": {
                      "type": "Compose",
                      "runAfter": {
                        "Until_analysis_complete": [
                          "Succeeded",
                          "TimedOut",
                          "Failed"
                        ]
                      },
                      "inputs": {
                        "vendor": "@coalesce(variables('result')?['analyzeResult']?['documents']?[0]?['fields']?['VendorName']?['valueString'], 'Unknown vendor')",
                        "invoiceId": "@coalesce(variables('result')?['analyzeResult']?['documents']?[0]?['fields']?['InvoiceId']?['valueString'], 'N/A')",
                        "total": "@coalesce(variables('result')?['analyzeResult']?['documents']?[0]?['fields']?['InvoiceTotal']?['valueCurrency']?['amount'], 0)",
                        "currency": "@coalesce(variables('result')?['analyzeResult']?['documents']?[0]?['fields']?['InvoiceTotal']?['valueCurrency']?['currencyCode'], 'N/A')",
                        "dueDate": "@coalesce(variables('result')?['analyzeResult']?['documents']?[0]?['fields']?['DueDate']?['valueDate'], 'N/A')"
                      }
                    },
                    "Was_extraction_successful": {
                      "type": "If",
                      "runAfter": {
                        "Extract_fields": [
                          "Succeeded"
                        ]
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@variables('status')",
                              "succeeded"
                            ]
                          },
                          {
                            "greater": [
                              "@outputs('Extract_fields')?['total']",
                              0
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Is_amount_above_threshold": {
                          "type": "If",
                          "runAfter": {},
                          "expression": {
                            "and": [
                              {
                                "greater": [
                                  "@outputs('Extract_fields')?['total']",
                                  "@parameters('approvalThreshold')"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Send_approval_email": {
                              "type": "ApiConnectionWebhook",
                              "runAfter": {},
                              "inputs": {
                                "host": {
                                  "connection": {
                                    "name": "@parameters('$connections')['outlook']['connectionId']"
                                  }
                                },
                                "path": "/approvalmail/$subscriptions",
                                "body": {
                                  "NotificationUrl": "@{listCallbackUrl()}",
                                  "Message": {
                                    "To": "@parameters('approverEmail')",
                                    "Subject": "Approval needed: @{outputs('Extract_fields')?['vendor']} invoice @{outputs('Extract_fields')?['invoiceId']}",
                                    "Options": "Approve, Reject",
                                    "Importance": "High",
                                    "HideHTMLMessage": false,
                                    "ShowHTMLConfirmationDialog": false,
                                    "Body": "Vendor: @{outputs('Extract_fields')?['vendor']}<br>Invoice #: @{outputs('Extract_fields')?['invoiceId']}<br>Amount: @{outputs('Extract_fields')?['total']} @{outputs('Extract_fields')?['currency']}<br>Due: @{outputs('Extract_fields')?['dueDate']}<br>Received from: @{coalesce(triggerBody()?['from'], triggerBody()?['From'])}"
                                  }
                                }
                              }
                            },
                            "Approved_or_rejected": {
                              "type": "If",
                              "runAfter": {
                                "Send_approval_email": [
                                  "Succeeded"
                                ]
                              },
                              "expression": {
                                "and": [
                                  {
                                    "equals": [
                                      "@body('Send_approval_email')?['SelectedOption']",
                                      "Approve"
                                    ]
                                  }
                                ]
                              },
                              "actions": {
                                "Set_decision_approved": {
                                  "type": "SetVariable",
                                  "runAfter": {},
                                  "inputs": {
                                    "name": "decision",
                                    "value": "Approved by manager"
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Set_decision_rejected": {
                                    "type": "SetVariable",
                                    "runAfter": {},
                                    "inputs": {
                                      "name": "decision",
                                      "value": "Rejected by manager"
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Set_decision_auto": {
                                "type": "SetVariable",
                                "runAfter": {},
                                "inputs": {
                                  "name": "decision",
                                  "value": "Auto-approved (below threshold)"
                                }
                              }
                            }
                          }
                        },
                        "Log_to_SQL_ledger": {
                          "type": "ApiConnection",
                          "runAfter": {
                            "Is_amount_above_threshold": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['sql']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServer')))},@{encodeURIComponent(encodeURIComponent(parameters('sqlDatabase')))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[Invoices]'))}/items",
                            "body": {
                              "Vendor": "@{outputs('Extract_fields')?['vendor']}",
                              "InvoiceNumber": "@{outputs('Extract_fields')?['invoiceId']}",
                              "Total": "@outputs('Extract_fields')?['total']",
                              "Currency": "@{outputs('Extract_fields')?['currency']}",
                              "DueDate": "@{outputs('Extract_fields')?['dueDate']}",
                              "Decision": "@{variables('decision')}",
                              "ReceivedFrom": "@{coalesce(triggerBody()?['from'], triggerBody()?['From'])}"
                            }
                          }
                        },
                        "Notify_finance_by_email": {
                          "type": "ApiConnection",
                          "runAfter": {
                            "Log_to_SQL_ledger": [
                              "Succeeded"
                            ]
                          },
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['outlook']['connectionId']"
                              }
                            },
                            "method": "post",
                            "path": "/v2/Mail",
                            "body": {
                              "To": "@parameters('financeEmail')",
                              "Subject": "Invoice processed: @{outputs('Extract_fields')?['vendor']} #@{outputs('Extract_fields')?['invoiceId']} - @{variables('decision')}",
                              "Body": "<p><b>Invoice processed</b></p><p>Vendor: @{outputs('Extract_fields')?['vendor']}<br>Invoice #: @{outputs('Extract_fields')?['invoiceId']}<br>Amount: @{outputs('Extract_fields')?['total']} @{outputs('Extract_fields')?['currency']}<br>Due: @{outputs('Extract_fields')?['dueDate']}<br>Decision: <b>@{variables('decision')}</b><br>Received from: @{coalesce(triggerBody()?['from'], triggerBody()?['From'])}</p>",
                              "Importance": "Normal"
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Ask_sender_to_resend": {
                            "type": "ApiConnection",
                            "runAfter": {},
                            "inputs": {
                              "host": {
                                "connection": {
                                  "name": "@parameters('$connections')['outlook']['connectionId']"
                                }
                              },
                              "method": "post",
                              "path": "/v2/Mail",
                              "body": {
                                "To": "@coalesce(triggerBody()?['from'], triggerBody()?['From'])",
                                "Subject": "We could not read your invoice: @{coalesce(items('For_each_attachment')?['name'], items('For_each_attachment')?['Name'])}",
                                "Body": "<p>Our automated system could not extract an amount from the attached invoice. Please resend a clear, text-based PDF.</p><p><small>Diagnostics: analysis status = @{variables('status')}; vendor = @{outputs('Extract_fields')?['vendor']}; total = @{outputs('Extract_fields')?['total']}</small></p>",
                                "Importance": "Normal"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          }
        },
        "parameters": {
          "approvalThreshold": {
            "value": "[parameters('approvalThreshold')]"
          },
          "approverEmail": {
            "value": "[parameters('approverEmail')]"
          },
          "diEndpoint": {
            "value": "[reference(variables('diId'), '2023-05-01').endpoint]"
          },
          "diKey": {
            "value": "[listKeys(variables('diId'), '2023-05-01').key1]"
          },
          "$connections": {
            "value": {
              "outlook": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'outlook')]",
                "connectionName": "outlook",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'outlook')]"
              },
              "azureblob": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'azureblob')]",
                "connectionName": "azureblob",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azureblob')]"
              },
              "sql": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'sql')]",
                "connectionName": "sql",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sql')]"
              }
            }
          },
          "financeEmail": {
            "value": "[parameters('financeEmail')]"
          },
          "sqlServer": {
            "value": "[variables('sqlFqdn')]"
          },
          "sqlDatabase": {
            "value": "[parameters('sqlDatabaseName')]"
          }
        }
      }
    }
  ]
}